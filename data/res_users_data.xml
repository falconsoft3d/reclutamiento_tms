<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!-- Usuario de Reclutamiento: es el único que ve la app Reclutamiento TMS.
         Sin contraseña: asígnela desde Ajustes › Usuarios (Acción › Cambiar contraseña) o envíe una invitación. -->
    <record id="user_reclutamiento" model="res.users">
        <field name="name">Reclutamiento</field>
        <field name="login">reclutamiento</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="company_ids" eval="[(6, 0, [ref('base.main_company')])]"/>
        <field name="group_ids" eval="[(6, 0, [ref('base.group_user'), ref('group_reclutamiento_manager')])]"/>
    </record>
</odoo>
