<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">
    <!-- Ejemplo: cargo Conductor de Camiones con su Plantilla de Datos, dos entrevistas y una noticia. -->
    <record id="ejemplo_plantilla_datos_conductor" model="reclutamiento.plantilla.datos">
        <field name="name">Conductor de Camiones</field>
        <field name="descripcion">Datos que completa el postulante a conductor de camiones en el portal.</field>
    </record>
    <record id="ejemplo_dato_lic_profesional" model="reclutamiento.plantilla.datos.linea">
        <field name="plantilla_id" ref="ejemplo_plantilla_datos_conductor"/>
        <field name="sequence">10</field>
        <field name="categoria_id" ref="categoria_licencias"/>
        <field name="name">¿Tenés licencia de conducir profesional vigente?</field>
        <field name="tipo">booleano</field>
        <field name="requerido" eval="True"/>
    </record>
    <record id="ejemplo_dato_lic_categoria" model="reclutamiento.plantilla.datos.linea">
        <field name="plantilla_id" ref="ejemplo_plantilla_datos_conductor"/>
        <field name="sequence">20</field>
        <field name="categoria_id" ref="categoria_licencias"/>
        <field name="name">Categoría de tu licencia</field>
        <field name="tipo">seleccion</field>
        <field name="requerido" eval="True"/>
        <field name="opcion_ids" eval="[(0, 0, {'name': 'C', 'sequence': 10}), (0, 0, {'name': 'E1', 'sequence': 20}), (0, 0, {'name': 'E2', 'sequence': 30}), (0, 0, {'name': 'E3', 'sequence': 40})]"/>
    </record>
    <record id="ejemplo_dato_lic_linti" model="reclutamiento.plantilla.datos.linea">
        <field name="plantilla_id" ref="ejemplo_plantilla_datos_conductor"/>
        <field name="sequence">30</field>
        <field name="categoria_id" ref="categoria_licencias"/>
        <field name="name">¿Tenés LINTI vigente?</field>
        <field name="tipo">booleano</field>
        <field name="requerido" eval="False"/>
        <field name="ayuda">Licencia Nacional de Transporte Interjurisdiccional.</field>
    </record>
    <record id="ejemplo_dato_lic_peligrosas" model="reclutamiento.plantilla.datos.linea">
        <field name="plantilla_id" ref="ejemplo_plantilla_datos_conductor"/>
        <field name="sequence">40</field>
        <field name="categoria_id" ref="categoria_licencias"/>
        <field name="name">¿Tenés el curso de cargas peligrosas vigente?</field>
        <field name="tipo">booleano</field>
        <field name="requerido" eval="False"/>
    </record>
    <record id="ejemplo_dato_veh_tanques" model="reclutamiento.plantilla.datos.linea">
        <field name="plantilla_id" ref="ejemplo_plantilla_datos_conductor"/>
        <field name="sequence">50</field>
        <field name="categoria_id" ref="categoria_vehiculos"/>
        <field name="name">¿Utilizaste tanques / cisternas?</field>
        <field name="tipo">booleano</field>
        <field name="requerido" eval="True"/>
    </record>
    <record id="ejemplo_dato_veh_tipos" model="reclutamiento.plantilla.datos.linea">
        <field name="plantilla_id" ref="ejemplo_plantilla_datos_conductor"/>
        <field name="sequence">60</field>
        <field name="categoria_id" ref="categoria_vehiculos"/>
        <field name="name">Vehículos que manejaste</field>
        <field name="tipo">multiple</field>
        <field name="requerido" eval="True"/>
        <field name="opcion_ids" eval="[(0, 0, {'name': 'Chasis', 'sequence': 10}), (0, 0, {'name': 'Chasis y acoplado', 'sequence': 20}), (0, 0, {'name': 'Batea', 'sequence': 30}), (0, 0, {'name': 'Semirremolque', 'sequence': 40}), (0, 0, {'name': 'Otros vehículos', 'sequence': 50})]"/>
    </record>
    <record id="ejemplo_dato_veh_productos" model="reclutamiento.plantilla.datos.linea">
        <field name="plantilla_id" ref="ejemplo_plantilla_datos_conductor"/>
        <field name="sequence">70</field>
        <field name="categoria_id" ref="categoria_vehiculos"/>
        <field name="name">Productos que transportaste</field>
        <field name="tipo">multiple</field>
        <field name="requerido" eval="False"/>
        <field name="opcion_ids" eval="[(0, 0, {'name': 'Gas licuado de petróleo (GLP)', 'sequence': 10}), (0, 0, {'name': 'Gases del aire (O2 / N2 / Ar / CO2)', 'sequence': 20}), (0, 0, {'name': 'Combustibles (nafta / diésel / kerosene / fuel oil)', 'sequence': 30}), (0, 0, {'name': 'Otros productos', 'sequence': 40})]"/>
    </record>
    <record id="ejemplo_dato_veh_experiencia" model="reclutamiento.plantilla.datos.linea">
        <field name="plantilla_id" ref="ejemplo_plantilla_datos_conductor"/>
        <field name="sequence">80</field>
        <field name="categoria_id" ref="categoria_vehiculos"/>
        <field name="name">Si marcaste al menos un producto, contanos tu experiencia</field>
        <field name="tipo">texto_largo</field>
        <field name="requerido" eval="False"/>
        <field name="ayuda">Empresa, producto, tipo de unidad y cuánto tiempo.</field>
    </record>
    <record id="ejemplo_dato_veh_caja" model="reclutamiento.plantilla.datos.linea">
        <field name="plantilla_id" ref="ejemplo_plantilla_datos_conductor"/>
        <field name="sequence">90</field>
        <field name="categoria_id" ref="categoria_vehiculos"/>
        <field name="name">Tipo de caja que manejás</field>
        <field name="tipo">seleccion</field>
        <field name="requerido" eval="False"/>
        <field name="opcion_ids" eval="[(0, 0, {'name': 'Manual', 'sequence': 10}), (0, 0, {'name': 'Automática', 'sequence': 20}), (0, 0, {'name': 'Ambas', 'sequence': 30})]"/>
    </record>
    <record id="ejemplo_dato_exp_anios" model="reclutamiento.plantilla.datos.linea">
        <field name="plantilla_id" ref="ejemplo_plantilla_datos_conductor"/>
        <field name="sequence">100</field>
        <field name="categoria_id" ref="categoria_experiencia"/>
        <field name="name">Años de experiencia como conductor profesional</field>
        <field name="tipo">seleccion</field>
        <field name="requerido" eval="True"/>
        <field name="opcion_ids" eval="[(0, 0, {'name': 'Menos de 1 año', 'sequence': 10}), (0, 0, {'name': 'De 1 a 3 años', 'sequence': 20}), (0, 0, {'name': 'De 3 a 5 años', 'sequence': 30}), (0, 0, {'name': 'Más de 5 años', 'sequence': 40})]"/>
    </record>
    <record id="ejemplo_dato_exp_empresa" model="reclutamiento.plantilla.datos.linea">
        <field name="plantilla_id" ref="ejemplo_plantilla_datos_conductor"/>
        <field name="sequence">110</field>
        <field name="categoria_id" ref="categoria_experiencia"/>
        <field name="name">Última empresa donde trabajaste</field>
        <field name="tipo">texto</field>
        <field name="requerido" eval="False"/>
    </record>
    <record id="ejemplo_dato_doc_licencia" model="reclutamiento.plantilla.datos.linea">
        <field name="plantilla_id" ref="ejemplo_plantilla_datos_conductor"/>
        <field name="sequence">120</field>
        <field name="categoria_id" ref="categoria_documentacion"/>
        <field name="name">Licencia de conducir (frente y dorso)</field>
        <field name="tipo">documento</field>
        <field name="requerido" eval="True"/>
    </record>
    <record id="ejemplo_dato_doc_antecedentes" model="reclutamiento.plantilla.datos.linea">
        <field name="plantilla_id" ref="ejemplo_plantilla_datos_conductor"/>
        <field name="sequence">130</field>
        <field name="categoria_id" ref="categoria_documentacion"/>
        <field name="name">Certificado de antecedentes penales</field>
        <field name="tipo">documento</field>
        <field name="requerido" eval="False"/>
    </record>
    <record id="ejemplo_entrevista_inicial" model="reclutamiento.plantilla.entrevista">
        <field name="name">Entrevista inicial - Conductor de Camiones</field>
    </record>
    <record id="ejemplo_entrevista_inicial_p1" model="reclutamiento.plantilla.entrevista.pregunta">
        <field name="plantilla_id" ref="ejemplo_entrevista_inicial"/>
        <field name="sequence">10</field>
        <field name="name">¿Tenés disponibilidad para viajes de larga distancia y para pernoctar fuera de tu casa?</field>
        <field name="tipo">booleano</field>
        <field name="puntos">10</field>
        <field name="respuesta_esperada">si</field>
    </record>
    <record id="ejemplo_entrevista_inicial_p2" model="reclutamiento.plantilla.entrevista.pregunta">
        <field name="plantilla_id" ref="ejemplo_entrevista_inicial"/>
        <field name="sequence">20</field>
        <field name="name">¿Tuviste algún siniestro vial con responsabilidad tuya en los últimos 3 años?</field>
        <field name="tipo">booleano</field>
        <field name="puntos">10</field>
        <field name="respuesta_esperada">no</field>
    </record>
    <record id="ejemplo_entrevista_inicial_p3" model="reclutamiento.plantilla.entrevista.pregunta">
        <field name="plantilla_id" ref="ejemplo_entrevista_inicial"/>
        <field name="sequence">30</field>
        <field name="name">¿Cuánto tiempo manejaste camiones con semirremolque?</field>
        <field name="tipo">opciones</field>
        <field name="opcion_ids" eval="[(0, 0, {'name': 'Nunca', 'puntos': 0, 'sequence': 10}), (0, 0, {'name': 'Menos de 2 años', 'puntos': 4, 'sequence': 20}), (0, 0, {'name': 'De 2 a 5 años', 'puntos': 7, 'sequence': 30}), (0, 0, {'name': 'Más de 5 años', 'puntos': 10, 'sequence': 40})]"/>
    </record>
    <record id="ejemplo_entrevista_inicial_p4" model="reclutamiento.plantilla.entrevista.pregunta">
        <field name="plantilla_id" ref="ejemplo_entrevista_inicial"/>
        <field name="sequence">40</field>
        <field name="name">La caja de un semirremolque mide 12 m de largo, 2,5 m de ancho y 2,6 m de alto. ¿Cuántos m³ tiene?</field>
        <field name="tipo">calculo</field>
        <field name="puntos">10</field>
        <field name="valor_esperado">78</field>
        <field name="unidad">m³</field>
        <field name="tolerancia">1</field>
        <field name="tolerancia_tipo">absoluta</field>
    </record>
    <record id="ejemplo_entrevista_inicial_p5" model="reclutamiento.plantilla.entrevista.pregunta">
        <field name="plantilla_id" ref="ejemplo_entrevista_inicial"/>
        <field name="sequence">50</field>
        <field name="name">Contanos cómo actuarías si durante un viaje con carga peligrosa detectás una pérdida en la cisterna.</field>
        <field name="tipo">abierta</field>
        <field name="puntos">20</field>
        <field name="criterio">Detener la unidad en un lugar seguro, apagar el motor, señalizar y alejar a las personas, evitar fuentes de ignición, usar los elementos de protección, consultar la ficha de intervención del producto y avisar de inmediato a la empresa y a los servicios de emergencia.</field>
    </record>
    <record id="ejemplo_entrevista_inicial_p6" model="reclutamiento.plantilla.entrevista.pregunta">
        <field name="plantilla_id" ref="ejemplo_entrevista_inicial"/>
        <field name="sequence">60</field>
        <field name="name">¿Por qué te gustaría trabajar en una empresa de transporte de sustancias peligrosas?</field>
        <field name="tipo">abierta</field>
        <field name="puntos">10</field>
        <field name="criterio">Motivación genuina, compromiso con la seguridad y el cumplimiento de normas, estabilidad y proyección a largo plazo.</field>
    </record>
    <record id="ejemplo_entrevista_tecnica" model="reclutamiento.plantilla.entrevista">
        <field name="name">Entrevista técnica - Seguridad y operación</field>
    </record>
    <record id="ejemplo_entrevista_tecnica_p1" model="reclutamiento.plantilla.entrevista.pregunta">
        <field name="plantilla_id" ref="ejemplo_entrevista_tecnica"/>
        <field name="sequence">10</field>
        <field name="name">Si el camión consume 35 litros cada 100 km, ¿cuántos litros necesitás para recorrer 450 km?</field>
        <field name="tipo">calculo</field>
        <field name="puntos">10</field>
        <field name="valor_esperado">157.5</field>
        <field name="unidad">litros</field>
        <field name="tolerancia">2</field>
        <field name="tolerancia_tipo">absoluta</field>
    </record>
    <record id="ejemplo_entrevista_tecnica_p2" model="reclutamiento.plantilla.entrevista.pregunta">
        <field name="plantilla_id" ref="ejemplo_entrevista_tecnica"/>
        <field name="sequence">20</field>
        <field name="name">Una cisterna de 30 m³ se carga al 85 %. ¿Cuántos m³ de producto lleva?</field>
        <field name="tipo">calculo</field>
        <field name="puntos">10</field>
        <field name="valor_esperado">25.5</field>
        <field name="unidad">m³</field>
        <field name="tolerancia">0.5</field>
        <field name="tolerancia_tipo">absoluta</field>
    </record>
    <record id="ejemplo_entrevista_tecnica_p3" model="reclutamiento.plantilla.entrevista.pregunta">
        <field name="plantilla_id" ref="ejemplo_entrevista_tecnica"/>
        <field name="sequence">30</field>
        <field name="name">¿Sabés usar el matafuego de la unidad?</field>
        <field name="tipo">booleano</field>
        <field name="puntos">5</field>
        <field name="respuesta_esperada">si</field>
    </record>
    <record id="ejemplo_entrevista_tecnica_p4" model="reclutamiento.plantilla.entrevista.pregunta">
        <field name="plantilla_id" ref="ejemplo_entrevista_tecnica"/>
        <field name="sequence">40</field>
        <field name="name">¿Qué documento indica cómo actuar ante una emergencia con el producto transportado?</field>
        <field name="tipo">opciones</field>
        <field name="opcion_ids" eval="[(0, 0, {'name': 'La ficha de intervención / hoja de seguridad del producto', 'puntos': 10, 'sequence': 10}), (0, 0, {'name': 'La cédula del vehículo', 'puntos': 0, 'sequence': 20}), (0, 0, {'name': 'El remito de la carga', 'puntos': 0, 'sequence': 30})]"/>
    </record>
    <record id="ejemplo_entrevista_tecnica_p5" model="reclutamiento.plantilla.entrevista.pregunta">
        <field name="plantilla_id" ref="ejemplo_entrevista_tecnica"/>
        <field name="sequence">50</field>
        <field name="name">Describí la inspección que hacés a la unidad antes de salir.</field>
        <field name="tipo">abierta</field>
        <field name="puntos">20</field>
        <field name="criterio">Neumáticos (presión y estado), luces, frenos, pérdidas de fluidos, niveles, documentación de la unidad y de la carga, elementos de seguridad (matafuego, balizas, kit antiderrame) y EPP.</field>
    </record>
    <record id="ejemplo_vacante_conductor" model="reclutamiento.vacante">
        <field name="name">Conductor de Camiones</field>
        <field name="ubicacion">Bosques, Florencio Varela (Buenos Aires)</field>
        <field name="modalidad">Tiempo completo - viajes de corta y larga distancia</field>
        <field name="cantidad">3</field>
        <field name="estado">publicada</field>
        <field name="usar_ia" eval="True"/>
        <field name="referencias_minimas">3</field>
        <field name="plantilla_datos_id" ref="ejemplo_plantilla_datos_conductor"/>
        <field name="descripcion" type="html"><p>Buscamos <b>conductores de camiones</b> para el transporte y la distribución de gases licuados, gases del aire y combustibles.</p><h4>Tareas</h4><ul><li>Conducir unidades chasis, semirremolque y cisterna en viajes de corta y larga distancia.</li><li>Realizar la inspección diaria de la unidad.</li><li>Cumplir los procedimientos de seguridad y de carga y descarga.</li></ul><h4>Ofrecemos</h4><ul><li>Relación de dependencia y estabilidad.</li><li>Capacitación permanente en seguridad vial y cargas peligrosas.</li><li>Flota moderna con mantenimiento propio.</li></ul></field>
        <field name="requisitos" type="html"><p><b>Excluyentes</b></p><ul><li>Licencia de conducir profesional vigente (categoría E1 o superior).</li><li>Experiencia comprobable de al menos 2 años manejando camiones.</li><li>Disponibilidad para viajar.</li></ul><p><b>Deseables</b></p><ul><li>LINTI y curso de cargas peligrosas vigentes.</li><li>Experiencia con cisternas de GLP, gases del aire o combustibles.</li><li>Sin siniestros viales con responsabilidad en los últimos 3 años.</li></ul></field>
        <field name="entrevista_ids" eval="[(0, 0, {'name': 'Entrevista inicial', 'sequence': 10, 'inicio': 'automatico', 'plantilla_id': ref('ejemplo_entrevista_inicial')}), (0, 0, {'name': 'Entrevista técnica', 'sequence': 20, 'inicio': 'manual', 'plantilla_id': ref('ejemplo_entrevista_tecnica')})]"/>
    </record>
    <record id="ejemplo_noticia_conductores" model="reclutamiento.noticia">
        <field name="name">Buscamos Conductores de Camiones</field>
        <field name="resumen">Sumamos conductores para nuestra flota de cisternas y semirremolques. Postulate en línea.</field>
        <field name="contenido" type="html"><p>Seguimos creciendo y abrimos la búsqueda de <b>conductores de camiones</b> para viajes de corta y larga distancia.</p><p>Si tenés licencia profesional y experiencia en transporte, completá el formulario y hacé la entrevista en línea: te lleva unos minutos.</p></field>
        <field name="publicada" eval="True"/>
        <field name="destacada" eval="True"/>
        <field name="vacante_id" ref="ejemplo_vacante_conductor"/>
    </record>
</odoo>
