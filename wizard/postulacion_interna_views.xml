<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_reclutamiento_postulacion_interna_wizard_form" model="ir.ui.view">
        <field name="name">reclutamiento.postulacion.interna.wizard.form</field>
        <field name="model">reclutamiento.postulacion.interna.wizard</field>
        <field name="arch" type="xml">
            <form string="Postular a búsqueda interna">
                <group>
                    <field name="employee_id" readonly="1"/>
                    <field name="vacante_id" options="{'no_create': True}"/>
                    <field name="enviar_enlaces"/>
                    <field name="nota"/>
                </group>
                <div class="text-muted small">
                    Se crea la postulación con los datos del empleado. Al aprobarla, el cargo, el departamento y los
                    datos evaluados se actualizan en su ficha.
                </div>
                <footer>
                    <button name="action_postular" type="object" string="Postular" class="btn-primary"/>
                    <button special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
