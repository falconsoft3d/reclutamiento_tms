<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_reclutamiento_vacante_list" model="ir.ui.view">
        <field name="name">reclutamiento.vacante.list</field>
        <field name="model">reclutamiento.vacante</field>
        <field name="arch" type="xml">
            <list string="Cargos / Vacantes" sample="1">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="job_id" optional="show"/>
                <field name="department_id" optional="show"/>
                <field name="ubicacion" optional="show"/>
                <field name="interna"/>
                <field name="usar_ia" optional="show"/>
                <field name="cantidad" optional="hide"/>
                <field name="postulacion_count"/>
                <field name="nuevas_count" optional="show"/>
                <field name="fecha_cierre" optional="show"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="estado" widget="badge" decoration-success="estado == 'publicada'"
                       decoration-muted="estado == 'cerrada'"/>
            </list>
        </field>
    </record>

    <record id="view_reclutamiento_vacante_kanban" model="ir.ui.view">
        <field name="name">reclutamiento.vacante.kanban</field>
        <field name="model">reclutamiento.vacante</field>
        <field name="arch" type="xml">
            <kanban sample="1" default_group_by="estado" group_create="0" group_delete="0" quick_create="0">
                <field name="estado"/>
                <field name="interna"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="name" class="fw-bold fs-5"/>
                            <span t-if="record.interna.raw_value" class="badge text-bg-info">Interna</span>
                        </div>
                        <field name="department_id" class="text-muted"/>
                        <field name="ubicacion" class="text-muted small"/>
                        <div class="d-flex gap-2 mt-2">
                            <button name="action_ver_postulaciones" type="object" class="btn btn-sm btn-primary">
                                <field name="postulacion_count"/> postulaciones
                            </button>
                            <span class="badge text-bg-light align-self-center"><field name="nuevas_count"/> nuevas</span>
                        </div>
                        <footer>
                            <field name="fecha_cierre" class="small text-muted"/>
                            <field name="user_id" widget="many2one_avatar_user" class="ms-auto"/>
                        </footer>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_reclutamiento_vacante_form" model="ir.ui.view">
        <field name="name">reclutamiento.vacante.form</field>
        <field name="model">reclutamiento.vacante</field>
        <field name="arch" type="xml">
            <form string="Cargo / Vacante">
                <header>
                    <button name="action_publicar" type="object" string="Publicar" class="btn-primary"
                            invisible="estado == 'publicada'"/>
                    <button name="action_cerrar" type="object" string="Cerrar búsqueda" invisible="estado != 'publicada'"/>
                    <button name="action_borrador" type="object" string="Volver a borrador" invisible="estado == 'borrador'"/>
                    <button name="action_abrir_portal" type="object" string="Ver en el portal" icon="fa-globe"
                            invisible="interna or estado != 'publicada'"/>
                    <field name="estado" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ver_postulaciones" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="postulacion_count" widget="statinfo" string="Postulaciones"/>
                        </button>
                        <button name="action_ver_postulaciones" type="object" class="oe_stat_button" icon="fa-check">
                            <field name="aprobadas_count" widget="statinfo" string="Aprobadas"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Interna" bg_color="text-bg-info" invisible="not interna"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ej.: Chofer de semirremolque cisterna"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="job_id"/>
                            <field name="department_id"/>
                            <field name="ubicacion"/>
                            <field name="modalidad"/>
                            <field name="cantidad"/>
                        </group>
                        <group>
                            <field name="user_id" widget="many2one_avatar_user"/>
                            <field name="interna"/>
                            <field name="usar_ia" widget="boolean_toggle"/>
                            <field name="fecha_apertura"/>
                            <field name="fecha_cierre"/>
                            <field name="referencias_minimas"/>
                            <field name="url_publica" widget="CopyClipboardChar" invisible="interna"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="descripcion" string="Descripción pública">
                            <field name="descripcion" placeholder="Lo que verá el postulante: tareas, beneficios, horario..."/>
                        </page>
                        <page name="requisitos" string="Requisitos (IA)">
                            <field name="requisitos"
                                   placeholder="Requisitos excluyentes y deseables. La IA los usa para el matching del perfil."/>
                        </page>
                        <page name="plantillas" string="Datos y entrevistas">
                            <group>
                                <field name="plantilla_datos_id"/>
                            </group>
                            <div class="alert alert-info" role="status">
                                Un cargo puede tener varias entrevistas. Las de inicio <b>Al postularse</b> se habilitan
                                apenas llega la postulación; las demás se habilitan cuando Selección envía el enlace
                                desde la postulación.
                            </div>
                            <field name="entrevista_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="plantilla_id"/>
                                    <field name="inicio"/>
                                    <field name="pregunta_count"/>
                                    <field name="puntos_max"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_reclutamiento_vacante_search" model="ir.ui.view">
        <field name="name">reclutamiento.vacante.search</field>
        <field name="model">reclutamiento.vacante</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="job_id"/>
                <field name="department_id"/>
                <filter name="publicadas" string="Publicadas" domain="[('estado', '=', 'publicada')]"/>
                <filter name="internas" string="Internas" domain="[('interna', '=', True)]"/>
                <group>
                    <filter name="group_estado" string="Estado" context="{'group_by': 'estado'}"/>
                    <filter name="group_department" string="Departamento" context="{'group_by': 'department_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reclutamiento_vacante" model="ir.actions.act_window">
        <field name="name">Cargos / Vacantes</field>
        <field name="res_model">reclutamiento.vacante</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cree la primera vacante</p>
            <p>Al publicarla aparece en el portal /reclutamiento_tms (salvo que sea una búsqueda interna).</p>
        </field>
    </record>
</odoo>
