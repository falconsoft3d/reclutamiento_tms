<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_employee_form_inherit_reclutamiento_tms" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.reclutamiento.tms</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_ver_reclutamiento_postulaciones" type="object" class="oe_stat_button"
                        icon="fa-briefcase" groups="reclutamiento_tms.group_reclutamiento_user" invisible="not id">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="reclutamiento_postulacion_count"/></span>
                        <span class="o_stat_text">Postulaciones</span>
                    </div>
                </button>
            </div>
            <header position="inside">
                <button name="action_postular_busqueda_interna" type="object" string="Postular a búsqueda interna"
                        groups="reclutamiento_tms.group_reclutamiento_user" invisible="not id"/>
            </header>
        </field>
    </record>
</odoo>
