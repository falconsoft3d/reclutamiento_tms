<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_reclutamiento_noticia_list" model="ir.ui.view">
        <field name="name">reclutamiento.noticia.list</field>
        <field name="model">reclutamiento.noticia</field>
        <field name="arch" type="xml">
            <list string="Noticias">
                <field name="fecha"/>
                <field name="name"/>
                <field name="vacante_id" optional="show"/>
                <field name="destacada"/>
                <field name="publicada" widget="boolean_toggle"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_reclutamiento_noticia_kanban" model="ir.ui.view">
        <field name="name">reclutamiento.noticia.kanban</field>
        <field name="model">reclutamiento.noticia</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="publicada"/>
                <templates>
                    <t t-name="card" class="p-0">
                        <field name="imagen" widget="image" class="w-100" options="{'img_class': 'w-100 object-fit-cover'}"
                               style="max-height: 140px; overflow: hidden;"/>
                        <div class="p-2">
                            <field name="name" class="fw-bold"/>
                            <field name="fecha" class="small text-muted"/>
                            <span t-if="record.publicada.raw_value" class="badge text-bg-success ms-1">Publicada</span>
                            <span t-else="" class="badge text-bg-secondary ms-1">Borrador</span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_reclutamiento_noticia_form" model="ir.ui.view">
        <field name="name">reclutamiento.noticia.form</field>
        <field name="model">reclutamiento.noticia</field>
        <field name="arch" type="xml">
            <form string="Noticia">
                <header>
                    <button name="action_publicar" type="object" string="Publicar" class="btn-primary" invisible="publicada"/>
                    <button name="action_despublicar" type="object" string="Despublicar" invisible="not publicada"/>
                    <button name="action_abrir_portal" type="object" string="Ver en el portal" icon="fa-globe"
                            invisible="not publicada"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Publicada" bg_color="text-bg-success" invisible="not publicada"/>
                    <field name="imagen" widget="image" class="oe_avatar" options="{'size': [180, 112]}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ej.: Sumamos 20 unidades nuevas a la flota"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="fecha"/>
                            <field name="destacada"/>
                            <field name="publicada" invisible="1"/>
                        </group>
                        <group>
                            <field name="vacante_id"/>
                            <field name="user_id"/>
                            <field name="url_publica" widget="CopyClipboardChar" invisible="not publicada"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <field name="resumen" placeholder="Texto corto para la tarjeta del portal..."/>
                    </group>
                    <field name="contenido" placeholder="Contenido de la noticia..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_reclutamiento_noticia" model="ir.actions.act_window">
        <field name="name">Noticias</field>
        <field name="res_model">reclutamiento.noticia</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Publique la primera noticia</p>
            <p>Las noticias publicadas se muestran en el portal de reclutamiento.</p>
        </field>
    </record>
</odoo>
