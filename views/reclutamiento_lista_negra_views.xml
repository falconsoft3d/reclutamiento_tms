<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_reclutamiento_lista_negra_list" model="ir.ui.view">
        <field name="name">reclutamiento.lista.negra.list</field>
        <field name="model">reclutamiento.lista.negra</field>
        <field name="arch" type="xml">
            <list string="Lista Negra" decoration-muted="sin_datos">
                <field name="name"/>
                <field name="documento"/>
                <field name="telefono"/>
                <field name="email"/>
                <field name="ubicacion"/>
                <field name="area_puesto"/>
                <field name="motivo"/>
                <field name="coincidencia_count" optional="show"/>
                <field name="sin_datos" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_reclutamiento_lista_negra_form" model="ir.ui.view">
        <field name="name">reclutamiento.lista.negra.form</field>
        <field name="model">reclutamiento.lista.negra</field>
        <field name="arch" type="xml">
            <form string="Lista Negra">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_ver_coincidencias" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="coincidencia_count" widget="statinfo" string="Postulaciones"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-secondary" invisible="active"/>
                    <div class="alert alert-warning" role="alert" invisible="not sin_datos">
                        Sin DNI, Teléfono ni Mail válidos: este registro no puede detectar postulaciones.
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Apellido y Nombre"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="documento"/>
                            <field name="telefono"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="ubicacion"/>
                            <field name="area_puesto"/>
                            <field name="user_id"/>
                            <field name="postulacion_origen_id" invisible="not postulacion_origen_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                            <field name="sin_datos" invisible="1"/>
                        </group>
                    </group>
                    <group string="Motivo / Detalle">
                        <field name="motivo" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_reclutamiento_lista_negra_search" model="ir.ui.view">
        <field name="name">reclutamiento.lista.negra.search</field>
        <field name="model">reclutamiento.lista.negra</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="documento"/>
                <field name="telefono"/>
                <field name="email"/>
                <field name="ubicacion"/>
                <field name="area_puesto"/>
                <field name="motivo"/>
                <filter name="sin_datos" string="Sin datos para controlar" domain="[('sin_datos', '=', True)]"/>
                <separator/>
                <filter name="archived" string="Archivados" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_area" string="Área / Puesto" context="{'group_by': 'area_puesto'}"/>
                    <filter name="group_ubicacion" string="Ubicación" context="{'group_by': 'ubicacion'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_reclutamiento_lista_negra" model="ir.actions.act_window">
        <field name="name">Lista Negra</field>
        <field name="res_model">reclutamiento.lista.negra</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Lista Negra vacía</p>
            <p>Puede importar la planilla (Favoritos › Importar registros): las columnas Apellido y Nombre, DNI,
                Teléfono, Mail, Ubicación, Área / Puesto y Motivo / Detalle se reconocen solas.</p>
        </field>
    </record>
</odoo>
