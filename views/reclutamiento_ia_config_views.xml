<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_reclutamiento_ia_config_form" model="ir.ui.view">
        <field name="name">reclutamiento.ia.config.form</field>
        <field name="model">reclutamiento.ia.config</field>
        <field name="arch" type="xml">
            <form string="API Cloud IA" create="0" delete="0">
                <header>
                    <button name="action_probar" type="object" string="Probar conexión" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Conexión">
                            <field name="activo" widget="boolean_toggle"/>
                            <field name="proveedor" widget="radio"/>
                            <field name="api_key" password="True" placeholder="Sin API Key la IA no hace nada"/>
                            <field name="modelo"/>
                            <field name="base_url"/>
                            <field name="timeout"/>
                        </group>
                        <group string="Puntaje global (suman 100)">
                            <field name="peso_cv"/>
                            <field name="peso_match"/>
                            <field name="peso_entrevista"/>
                            <field name="max_repreguntas"/>
                            <field name="max_cv_chars"/>
                        </group>
                    </group>
                    <group string="Instrucciones adicionales para la IA">
                        <field name="instrucciones" nolabel="1" colspan="2"
                               placeholder="Ej.: valorar especialmente la experiencia en transporte de sustancias peligrosas y la licencia LINTI."/>
                    </group>
                    <div class="alert alert-secondary" role="status" invisible="not ultimo_test">
                        <field name="ultimo_test" readonly="1"/>
                    </div>
                    <div class="alert alert-warning" role="status" invisible="activo and api_key">
                        La IA está <b>desactivada</b> o sin API Key: no se evalúan postulaciones ni hay repreguntas.
                        Las entrevistas funcionan igual y puntúan solas las preguntas Sí/No, de opciones y de cálculo.
                    </div>
                    <div class="alert alert-info" role="status">
                        Si no hay entrevistas terminadas, el puntaje global se reparte solo entre Análisis de CV y
                        Matching de perfil. Las postulaciones se evalúan en segundo plano cada pocos minutos.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_reclutamiento_ia_config" model="ir.actions.act_window">
        <field name="name">API Cloud IA</field>
        <field name="res_model">reclutamiento.ia.config</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="ia_config_default"/>
    </record>
</odoo>
