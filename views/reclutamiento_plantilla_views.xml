<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- ===================== ETAPAS ===================== -->
    <record id="view_reclutamiento_etapa_list" model="ir.ui.view">
        <field name="name">reclutamiento.etapa.list</field>
        <field name="model">reclutamiento.etapa</field>
        <field name="arch" type="xml">
            <list string="Etapas" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="codigo"/>
                <field name="fold"/>
                <field name="descripcion"/>
            </list>
        </field>
    </record>
    <record id="action_reclutamiento_etapa" model="ir.actions.act_window">
        <field name="name">Etapas</field>
        <field name="res_model">reclutamiento.etapa</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ===================== CATEGORÍAS ===================== -->
    <record id="view_reclutamiento_categoria_list" model="ir.ui.view">
        <field name="name">reclutamiento.categoria.list</field>
        <field name="model">reclutamiento.categoria</field>
        <field name="arch" type="xml">
            <list string="Categorías" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="descripcion"/>
            </list>
        </field>
    </record>
    <record id="action_reclutamiento_categoria" model="ir.actions.act_window">
        <field name="name">Categorías de datos</field>
        <field name="res_model">reclutamiento.categoria</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ===================== PLANTILLA DE DATOS ===================== -->
    <record id="view_reclutamiento_plantilla_datos_list" model="ir.ui.view">
        <field name="name">reclutamiento.plantilla.datos.list</field>
        <field name="model">reclutamiento.plantilla.datos</field>
        <field name="arch" type="xml">
            <list string="Plantillas de Datos">
                <field name="name"/>
                <field name="descripcion"/>
                <field name="vacante_count"/>
            </list>
        </field>
    </record>

    <record id="view_reclutamiento_plantilla_datos_form" model="ir.ui.view">
        <field name="name">reclutamiento.plantilla.datos.form</field>
        <field name="model">reclutamiento.plantilla.datos</field>
        <field name="arch" type="xml">
            <form string="Plantilla de Datos">
                <sheet>
                    <widget name="web_ribbon" title="Archivada" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ej.: Chofer de cisterna"/></h1>
                    </div>
                    <field name="descripcion" placeholder="Descripción interna..."/>
                    <field name="active" invisible="1"/>
                    <div class="alert alert-info mt-2" role="status">
                        Cada campo se muestra en el portal dentro de su categoría. En <b>Opción única</b> y
                        <b>Opción múltiple</b> abra la línea para cargar las opciones. Con <b>Traspasar a campo del
                        empleado</b> la respuesta se copia a la ficha al aprobar.
                    </div>
                    <field name="linea_ids" context="{'default_plantilla_id': id}">
                        <list>
                            <field name="sequence" widget="handle"/>
                            <field name="categoria_id"/>
                            <field name="name"/>
                            <field name="tipo"/>
                            <field name="requerido"/>
                            <field name="opcion_ids" widget="many2many_tags" string="Opciones"/>
                            <field name="campo_empleado_id" optional="hide"/>
                        </list>
                        <form string="Campo">
                            <group>
                                <group>
                                    <field name="categoria_id"/>
                                    <field name="name"/>
                                    <field name="tipo"/>
                                    <field name="requerido"/>
                                </group>
                                <group>
                                    <field name="ayuda"/>
                                    <field name="campo_empleado_id" options="{'no_create': True}"
                                           invisible="tipo == 'documento'"/>
                                </group>
                            </group>
                            <field name="opcion_ids" invisible="tipo not in ('seleccion', 'multiple')">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </form>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_reclutamiento_plantilla_datos" model="ir.actions.act_window">
        <field name="name">Plantillas de Datos</field>
        <field name="res_model">reclutamiento.plantilla.datos</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cree la primera Plantilla de Datos</p>
            <p>Campos organizados por categoría (Educación, Experiencia, Documentación...) que el postulante
                completa en el portal según el cargo.</p>
        </field>
    </record>

    <!-- ===================== PLANTILLA DE ENTREVISTA ===================== -->
    <record id="view_reclutamiento_plantilla_entrevista_list" model="ir.ui.view">
        <field name="name">reclutamiento.plantilla.entrevista.list</field>
        <field name="model">reclutamiento.plantilla.entrevista</field>
        <field name="arch" type="xml">
            <list string="Plantillas de Entrevista">
                <field name="name"/>
                <field name="pregunta_count"/>
                <field name="puntos_max"/>
            </list>
        </field>
    </record>

    <record id="view_reclutamiento_plantilla_entrevista_form" model="ir.ui.view">
        <field name="name">reclutamiento.plantilla.entrevista.form</field>
        <field name="model">reclutamiento.plantilla.entrevista</field>
        <field name="arch" type="xml">
            <form string="Plantilla de Entrevista">
                <sheet>
                    <widget name="web_ribbon" title="Archivada" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ej.: Entrevista inicial chofer"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="puntos_max"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="preguntas" string="Preguntas">
                            <div class="alert alert-info" role="status">
                                <b>Sí / No</b>: suma los puntos si responde lo esperado.
                                <b>Opciones</b>: cada opción tiene su puntaje.
                                <b>Cálculo</b>: suma los puntos si el número está dentro de la tolerancia.
                                <b>Abierta</b>: la IA puede repreguntar y la puntúa según el criterio.
                            </div>
                            <field name="pregunta_ids">
                                <list>
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="tipo"/>
                                    <field name="puntos_max" string="Puntos"/>
                                    <field name="imagen" widget="image" options="{'size': [40, 40]}" optional="show"/>
                                </list>
                                <form string="Pregunta">
                                    <group>
                                        <group>
                                            <field name="tipo"/>
                                            <field name="puntos" invisible="tipo == 'opciones'"/>
                                            <field name="respuesta_esperada" invisible="tipo != 'booleano'"
                                                   required="tipo == 'booleano'"/>
                                            <field name="valor_esperado" invisible="tipo != 'calculo'"/>
                                            <field name="unidad" invisible="tipo != 'calculo'"/>
                                            <label for="tolerancia" invisible="tipo != 'calculo'"/>
                                            <div class="o_row" invisible="tipo != 'calculo'">
                                                <field name="tolerancia"/>
                                                <field name="tolerancia_tipo"/>
                                            </div>
                                        </group>
                                        <group>
                                            <field name="imagen" widget="image" options="{'size': [200, 200]}"/>
                                        </group>
                                    </group>
                                    <group>
                                        <field name="name" placeholder="Ej.: Un semirremolque mide 12 m x 2,5 m x 2,6 m. ¿Cuántos m³ tiene?"/>
                                        <field name="criterio" invisible="tipo != 'abierta'"
                                               placeholder="Qué debería contener una buena respuesta..."/>
                                    </group>
                                    <field name="opcion_ids" invisible="tipo != 'opciones'">
                                        <list editable="bottom">
                                            <field name="sequence" widget="handle"/>
                                            <field name="name"/>
                                            <field name="puntos"/>
                                        </list>
                                    </field>
                                </form>
                            </field>
                        </page>
                        <page name="mensajes" string="Mensajes del chat">
                            <group>
                                <field name="mensaje_inicial"/>
                                <field name="mensaje_final"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_reclutamiento_plantilla_entrevista" model="ir.actions.act_window">
        <field name="name">Plantillas de Entrevista</field>
        <field name="res_model">reclutamiento.plantilla.entrevista</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Cree la primera Plantilla de Entrevista</p>
            <p>Preguntas Sí/No, con opciones, de cálculo y abiertas para la entrevista interactiva con IA.</p>
        </field>
    </record>
</odoo>
